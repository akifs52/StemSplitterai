# StemSplit AI Environment Configuration Template
# Copy this file to .env and fill in your actual values.

STEM_PUBLIC_BASE_URL=http://127.0.0.1:8000

# Google OAuth (from Google Cloud Console)
STEM_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
STEM_GOOGLE_CLIENT_SECRET=your-google-client-secret

# Apple OAuth (Optional)
STEM_APPLE_CLIENT_ID=
STEM_APPLE_TEAM_ID=
STEM_APPLE_KEY_ID=
STEM_APPLE_PRIVATE_KEY=
STEM_APPLE_PRIVATE_KEY_PATH=

# Auth & Security
STEM_AUTH_SECRET_KEY=change-me-before-production
STEM_ACCESS_TOKEN_EXPIRE_MINUTES=1440
